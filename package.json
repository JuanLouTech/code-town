{
  "name": "code-town",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A cozy island where every folder is a farm and every Claude Code session is a villager.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"CODETOWN_DEV=1 tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts --open",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
